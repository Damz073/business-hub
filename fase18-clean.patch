+              <label className="label">Pagamento<select className="input" value={selected.payment_status || ''} onChange={(e) => setSelected({ ...selected, payment_status: e.target.value })}><option value="aguardando_pagamento">aguardando_pagamento</option><option value="pending_confirmation">pending_confirmation</option><option value="confirmado">confirmado</option><option value="cancelado">cancelado</option></select></label>
+              <label className="label">Origem<select className="input" value={selected.source || 'whatsapp'} onChange={(e) => setSelected({ ...selected, source: e.target.value })}><option value="whatsapp">whatsapp</option><option value="balcao">balcao</option><option value="telefone">telefone</option><option value="site">site</option></select></label>
+              <label className="label">Check-in<input className="input" type="date" value={selected.checkin_date || ''} onChange={(e) => setSelected({ ...selected, checkin_date: e.target.value })} /></label>
+              <label className="label">Check-out<input className="input" type="date" value={selected.checkout_date || ''} onChange={(e) => setSelected({ ...selected, checkout_date: e.target.value })} /></label>
+              <label className="label">Quarto<input className="input" value={selected.unit_category || ''} onChange={(e) => setSelected({ ...selected, unit_category: e.target.value })} /></label>
+              <label className="label">Valor<input className="input" type="number" value={selected.total_value || selected.quoted_amount || 0} onChange={(e) => setSelected({ ...selected, total_value: Number(e.target.value), quoted_amount: Number(e.target.value) })} /></label>
+              <label className="label">Telefone<input className="input" value={selected.main_guest_phone || selected.guest_phone || ''} onChange={(e) => setSelected({ ...selected, main_guest_phone: e.target.value, guest_phone: e.target.value })} /></label>
+              <label className="label">E-mail<input className="input" value={selected.guest_email || ''} onChange={(e) => setSelected({ ...selected, guest_email: e.target.value })} /></label>
+              <label className="label">CPF<input className="input" value={selected.guest_document || ''} onChange={(e) => setSelected({ ...selected, guest_document: e.target.value })} /></label>
+              <label className="label">Cidade<input className="input" value={selected.guest_city || ''} onChange={(e) => setSelected({ ...selected, guest_city: e.target.value })} /></label>
+              <label className="label">Placa<input className="input" value={selected.car_plate || ''} onChange={(e) => setSelected({ ...selected, car_plate: e.target.value })} /></label>
+              <label className="label">Chegada prevista<input className="input" value={selected.estimated_arrival || ''} onChange={(e) => setSelected({ ...selected, estimated_arrival: e.target.value })} /></label>
+              <label className="label">Hóspede principal<input className="input" value={selected.main_guest_name || selected.guest_name || ''} onChange={(e) => setSelected({ ...selected, main_guest_name: e.target.value, guest_name: e.target.value })} /></label>
+            </div>
+            <label className="label">Observações internas<textarea className="input" value={selected.notes_internal || ''} onChange={(e) => setSelected({ ...selected, notes_internal: e.target.value })} /></label>
+            <label className="label">Observações da reserva<textarea className="input" value={selected.notes || ''} onChange={(e) => setSelected({ ...selected, notes: e.target.value })} /></label>
+            <div className="guest-list-panel">
+              <div className="section-row"><h3 className="section-subtitle">Ficha dos hóspedes</h3><div className="pill info">{selected.guests?.length || 0} registros</div></div>
+              {(selected.guests || []).map((guest, index) => (
+                <div key={index} className="guest-chip-grid">
+                  <input className="input" value={guest.name || ''} placeholder="Nome" onChange={(e) => setSelected({ ...selected, guests: (selected.guests || []).map((item, itemIndex) => itemIndex === index ? { ...item, name: e.target.value } : item) })} />
+                  <input className="input" value={guest.cpf || ''} placeholder="CPF" onChange={(e) => setSelected({ ...selected, guests: (selected.guests || []).map((item, itemIndex) => itemIndex === index ? { ...item, cpf: e.target.value } : item) })} />
+                  <input className="input" value={guest.phone || ''} placeholder="Telefone" onChange={(e) => setSelected({ ...selected, guests: (selected.guests || []).map((item, itemIndex) => itemIndex === index ? { ...item, phone: e.target.value } : item) })} />
+                </div>
+              ))}
+            </div>
+            <div className="modal-actions">
+              <button className="button success" onClick={confirmPayment} disabled={saving}>Confirmar pagamento</button>
+              <button className="button" onClick={saveReservation} disabled={saving}>{saving ? 'Salvando...' : 'Salvar alterações'}</button>
+              <button className="button warning" onClick={cancelReservation} disabled={saving}>Cancelar reserva</button>
+            </div>
+          </div>
+        </div>
+      ) : null}
+    </div>
+  );
+}
