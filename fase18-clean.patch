+"use client";
+import { useEffect, useMemo, useState } from "react";
+import { ProtectedPage } from "@/components/ProtectedPage";
+import { apiFetch } from "@/lib/api";
+import { formatCurrency } from "@/lib/format";
+import { ReservationItem, ReservationsCalendarResponse } from "@/types/hospitality";
+
+export default function ReservationMapPage() { return <ProtectedPage>{() => <ReservationMapContent />}</ProtectedPage>; }
+
+const STATUS_CLASS: Record<string, string> = {
+  confirmada: 'status-confirmada',
+  aguardando_pagamento: 'status-aguardando',
+  cancelada: 'status-cancelada',
+  bloqueada: 'status-bloqueada',
+  lead: 'status-lead',
+  checkin: 'status-checkin',
+  checkout: 'status-checkout',
+};
+
+function plusDays(base: Date, days: number) {
+  const next = new Date(base);
+  next.setDate(next.getDate() + days);
+  return next;
+}
+
+function toISO(date: Date) { return date.toISOString().slice(0, 10); }
+
+function ReservationMapContent() {
+  const initial = useMemo(() => {
+    const base = new Date();
+    base.setDate(1);
+    return base;
+  }, []);
+  const [monthBase, setMonthBase] = useState(initial);
+  const [calendar, setCalendar] = useState<ReservationsCalendarResponse | null>(null);
+  const [selected, setSelected] = useState<ReservationItem | null>(null);
+  const [error, setError] = useState("");
+  const [saving, setSaving] = useState(false);
+
+  const startDate = useMemo(() => toISO(monthBase), [monthBase]);
+  const endDate = useMemo(() => toISO(plusDays(monthBase, 40)), [monthBase]);
+  const days = useMemo(() => Array.from({ length: 31 }, (_, index) => plusDays(monthBase, index)), [monthBase]);
+
+  async function load() {
+    try {
+      const data = await apiFetch<ReservationsCalendarResponse>(`/hospitality/reservations/calendar?start_date=${startDate}&end_date=${endDate}`);
+      setCalendar(data);
+    } catch (err) {
+      setError(err instanceof Error ? err.message : 'Erro ao carregar o mapa de reservas.');
+    }
+  }
+
+  useEffect(() => { load(); }, [startDate, endDate]);
+
+  function openReservation(reservation: ReservationItem) { setSelected(JSON.parse(JSON.stringify(reservation))); }
+
+  async function saveReservation() {
+    if (!selected) return;
+    setSaving(true); setError("");
+    try {
+      await apiFetch(`/hospitality/reservations/${selected.id}`, { method: 'PUT', body: JSON.stringify(selected) });
+      await load();
+      setSaving(false);
+    } catch (err) {
+      setSaving(false);
+      setError(err instanceof Error ? err.message : 'Erro ao salvar a reserva.');
+    }
+  }
+
+  async function confirmPayment() {
+    if (!selected) return;
+    setSaving(true);
+    try {
+      await apiFetch(`/hospitality/reservations/${selected.id}/confirm-payment`, { method: 'POST' });
+      await load();
+      const detail = await apiFetch<{item: ReservationItem}>(`/hospitality/reservations/${selected.id}`);
+      setSelected(detail.item);
+      setSaving(false);
+    } catch (err) {
+      setSaving(false);
+      setError(err instanceof Error ? err.message : 'Erro ao confirmar pagamento.');
+    }
+  }
+
+  async function cancelReservation() {
+    if (!selected) return;
+    setSaving(true);
+    try {
+      await apiFetch(`/hospitality/reservations/${selected.id}/cancel`, { method: 'POST', body: JSON.stringify({ notes_internal: selected.notes_internal || 'Cancelada pelo painel PMS.' }) });
+      await load();
+      const detail = await apiFetch<{item: ReservationItem}>(`/hospitality/reservations/${selected.id}`);
+      setSelected(detail.item);
+      setSaving(false);
+    } catch (err) {
+      setSaving(false);
+      setError(err instanceof Error ? err.message : 'Erro ao cancelar reserva.');
+    }
+  }
+
+  const monthLabel = monthBase.toLocaleDateString('pt-BR', { month: 'long', year: 'numeric' });
+
+  return (
+    <div className="page-grid reservations-map-page">
+      <div className="card hero-panel fade-up premium-glow">
+        <div className="hero-copy">
+          <div className="eyebrow">Mapa de Reservas • PMS visual</div>
+          <h2>Visualização por quarto, por dia e com interação de reserva.</h2>
+          <p>Essa tela é o início da transformação do dashboard em PMS: leitura operacional rápida, cores por status e edição da ficha do hóspede sem sair do mapa.</p>
+        </div>
+        <div className="calendar-nav">
+          <button className="button ghost" onClick={() => setMonthBase(new Date(monthBase.getFullYear(), monthBase.getMonth() - 1, 1))}>← mês anterior</button>
+          <div className="calendar-month-label">{monthLabel}</div>
+          <button className="button ghost" onClick={() => setMonthBase(new Date(monthBase.getFullYear(), monthBase.getMonth() + 1, 1))}>próximo mês →</button>
+        </div>
+      </div>
+      {error ? <div className="error-box">{error}</div> : null}
+
+      <div className="card fade-up reservation-map-shell">
+        <div className="reservation-map-grid">
+          <div className="map-corner">Quartos</div>
+          {days.map((day) => <div key={day.toISOString()} className="map-day-header"><strong>{day.toLocaleDateString('pt-BR', { day: '2-digit' })}</strong><span>{day.toLocaleDateString('pt-BR', { weekday: 'short' })}</span></div>)}
+          {(calendar?.rooms || []).map((room) => {
+            const roomReservations = (calendar?.items || []).filter((item) => item.room_code === room.code);
+            return (
+              <>
+                <div key={`label-${room.id}`} className="map-room-label"><strong>{room.name}</strong><span>{room.code}</span></div>
+                {days.map((day, index) => {
+                  const iso = toISO(day);
+                  const reservation = roomReservations.find((item) => item.checkin && item.checkout && iso >= item.checkin && iso < item.checkout);
+                  const startsHere = reservation?.checkin === iso;
+                  const checkoutDate = reservation?.checkout ? new Date(reservation.checkout) : null;
+                  const checkinDate = reservation?.checkin ? new Date(reservation.checkin) : null;
+                  const span = startsHere && checkoutDate && checkinDate ? Math.max(1, Math.ceil((checkoutDate.getTime() - checkinDate.getTime()) / 86400000)) : 1;
+                  return (
+                    <div key={`${room.id}-${index}`} className="map-day-cell">
+                      {startsHere && reservation ? (
+                        <button className={`reservation-block ${STATUS_CLASS[reservation.status] || 'status-lead'}`} style={{ gridColumn: `span ${Math.min(span, days.length - index)}` }} onClick={() => openReservation(reservation.reservation)}>
+                          <strong>{reservation.guest_name || 'Reserva'}</strong>
+                          <span>{reservation.room_code} • {formatCurrency(reservation.total_value || 0)}</span>
+                        </button>
+                      ) : null}
+                    </div>
+                  );
+                })}
+              </>
+            );
+          })}
+        </div>
+      </div>
+
+      {selected ? (
+        <div className="reservation-modal-backdrop" onClick={() => setSelected(null)}>
+          <div className="reservation-modal card" onClick={(event) => event.stopPropagation()}>
+            <div className="section-row"><div><div className="eyebrow">{selected.reservation_code || `RES-${selected.id}`}</div><h2 className="section-title modal-title">{selected.main_guest_name || selected.guest_name || 'Reserva'}</h2></div><button className="button ghost" onClick={() => setSelected(null)}>Fechar</button></div>
+            <div className="three-col compact-grid">
